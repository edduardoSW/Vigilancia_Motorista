# Agente de monitoramento em Linux (x86_64 ou arm64, inclui Raspberry Pi) com webcam USB.
# O Docker Desktop do Windows e do macOS não repassa a webcam para o contêiner:
# nesses sistemas rode o caixa/run_monitor.py direto no Python.
# Contexto de build: a raiz do repositório (implantacao/docker-compose.yml, ou na raiz:
#   docker build -f implantacao/Dockerfile.caixa .).
FROM python:3.14.7-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DRIVESAFE_DATA_DIR=/dados

# libgl1 e libglib2.0-0 são exigidas pelo OpenCV; alsa-utils traz o aplay usado pela sirene.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY caixa/requirements.txt caixa/
RUN pip install --no-cache-dir -r caixa/requirements.txt

# Mesma disposição do repositório: o analisar_video.py acha o vision/ em ../caixa.
COPY caixa/vision ./caixa/vision
COPY caixa/run_monitor.py ./caixa/
COPY ferramentas/analisar_video.py ./ferramentas/

RUN useradd --system --uid 10001 --home-dir /app drivesafe \
    && mkdir -p /dados \
    && chown drivesafe /dados
USER drivesafe

VOLUME ["/dados"]

WORKDIR /app/caixa

CMD ["python", "run_monitor.py", "--no-window"]
