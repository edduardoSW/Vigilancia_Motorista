# Agente de monitoramento em Linux (x86_64 ou arm64, inclui Raspberry Pi) com webcam USB.
# O Docker Desktop do Windows e do macOS não repassa a webcam para o contêiner:
# nesses sistemas rode o run_monitor.py direto no Python.
FROM python:3.14.7-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DRIVESAFE_DATA_DIR=/dados

# libgl1 e libglib2.0-0 são exigidas pelo OpenCV; alsa-utils traz o aplay usado pela sirene.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-device.txt .
RUN pip install --no-cache-dir -r requirements-device.txt

COPY vision ./vision
COPY run_monitor.py analisar_video.py ./

RUN useradd --system --uid 10001 --home-dir /app drivesafe \
    && mkdir -p /dados \
    && chown drivesafe /dados
USER drivesafe

VOLUME ["/dados"]

CMD ["python", "run_monitor.py", "--no-window"]
