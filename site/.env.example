# Copie para .env.local; PIN real nunca deve ser escrito aqui.
# O acesso de demonstração usa o hash com sal em src/lib/acesso-local.ts.

# Contato: somente dígitos, DDI + DDD + número. Vazio = aviso de contato em preparação.
NEXT_PUBLIC_ROTAGUARD_WHATSAPP=
NEXT_PUBLIC_ROTAGUARD_TELEFONE=

# Domínio real e indexação: 1 somente quando estiver pronto para publicação.
NEXT_PUBLIC_ROTAGUARD_DOMINIO=
NEXT_PUBLIC_ROTAGUARD_INDEXAR=

# Base dos instaladores efetivamente publicados; não há arquivos fictícios.
NEXT_PUBLIC_ROTAGUARD_DOWNLOADS_BASE=
NEXT_PUBLIC_ROTAGUARD_PWA_URL=
