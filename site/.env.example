# Copie para .env.local (fora do git) e preencha.

# Acesso à área de download (gere com: node scripts/gerar-hash-pin.mjs)
ROTAGUARD_PIN_HASH=
ROTAGUARD_SESSAO_SEGREDO=

# Contato (só dígitos, com DDI e DDD, ex.: 5511999990000). Vazio = botões desativados com aviso.
NEXT_PUBLIC_ROTAGUARD_WHATSAPP=
NEXT_PUBLIC_ROTAGUARD_TELEFONE=

# Domínio público (canonical e Open Graph) e indexação (1 = liberar buscadores)
NEXT_PUBLIC_ROTAGUARD_DOMINIO=
NEXT_PUBLIC_ROTAGUARD_INDEXAR=

# Downloads do app (pasta dos arquivos da release) e endereço do PWA para iPhone
NEXT_PUBLIC_ROTAGUARD_DOWNLOADS_BASE=
NEXT_PUBLIC_ROTAGUARD_PWA_URL=
