# Configuração do dispositivo DriveSafe AI. Copie para /etc/drivesafe/device.env e ajuste.

# Servidor central: IP da máquina com start_system.py --host 0.0.0.0 (ou o Docker).
DRIVESAFE_SERVER_URL=http://192.168.0.10:8000

# Token gerado no servidor com:
#   python manage.py criar-dispositivo --nome "Caminhão ABC-1234" --veiculo 1
DRIVESAFE_DEVICE_TOKEN=dsk_troque_pelo_token_do_dispositivo

# 0 = primeira webcam USB, /dev/video0, ou picamera2 para o Pi Camera Module.
DRIVESAFE_CAMERA=0

# Câmera infravermelha (850/940 nm com iluminador): sim, nao ou auto. Só com "sim" a pupila pode ser medida.
#DRIVESAFE_CAMERA_IR=nao

# Um perfil de calibração por motorista (letras, números, - e _).
DRIVESAFE_DRIVER_KEY=padrao

# Guardar perfil de calibração e linha de base entre viagens. Só ligue com o consentimento do motorista (LGPD).
#DRIVESAFE_CONSENTIMENTO_PERFIL=1

# Calibração no início de cada viagem, em segundos (padrão: 300 a 600 = 5 a 10 min).
#DRIVESAFE_CALIBRATION_MIN_S=300
#DRIVESAFE_CALIBRATION_MAX_S=600

# Sinais compatíveis com ativação atípica: desligado, local (padrão: só no dispositivo) ou enviar.
# "enviar" manda dado pessoal sensível ao servidor: exige base legal e consentimento.
#DRIVESAFE_SINAIS_ATIVACAO=local

# Detecção de uso de celular (padrão: ligada). Desligue se o Raspberry Pi não aguentar.
#DRIVESAFE_CELULAR=0

# Arquivo JSON com a velocidade do veículo, escrito por outro programa (GPS, OBD-II):
#   {"velocidade_kmh": 72.5, "atualizado_em": 1757520000}
#DRIVESAFE_TELEMETRIA_ARQUIVO=/run/drivesafe/telemetria.json

# Checagem de óculos escuros (desliga as medidas do olho quando a lente cobre os olhos).
#DRIVESAFE_DETECTAR_OCULOS_ESCUROS=1

# Buzzer ligado a um pino GPIO (numeração BCM). O Raspberry Pi 5 não tem saída de áudio P2:
# use buzzer, caixa de som USB ou HDMI.
#DRIVESAFE_BUZZER_PIN=17
#DRIVESAFE_MUTE=1
